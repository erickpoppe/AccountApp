# Database
DB_USER=bigcapital
DB_PASSWORD=change_me_password
DB_ROOT_PASSWORD=change_me_root_password
DB_CHARSET=utf8

# System DB name
SYSTEM_DB_NAME=bigcapital_system
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# Auth — generate a random string: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret

# App public URL (the droplet's IP or domain)
BASE_URL=http://YOUR_DROPLET_IP

# S3 file storage (set to 'none' to disable — required to prevent server crash)
S3_BUCKET=none
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=none
S3_SECRET_ACCESS_KEY=none
